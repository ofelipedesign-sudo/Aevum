const Button = ({ children, variant = 'primary', href, className = '', onClick, type = 'button' }) => {
  const baseStyle = "inline-flex items-center justify-center px-6 py-3 font-heading text-sm font-medium transition-all duration-300 ease-out";
  
  const variants = {
    primary: "bg-[#C5A477] text-[#101010] hover:bg-[#F2EFE8] shadow-[0_0_15px_rgba(197,164,119,0.2)] hover:shadow-[0_0_25px_rgba(242,239,232,0.4)]",
    secondary: "bg-transparent border border-[#C5A477] text-[#C5A477] hover:bg-[#C5A477] hover:text-[#101010]",
    outline: "bg-transparent border border-[#303234] text-[#F2EFE8] hover:border-[#C5A477] hover:text-[#C5A477]"
  };

  const Element = href ? 'a' : 'button';

  return (
    <Element 
      href={href} 
      className={`${baseStyle} ${variants[variant]} ${className}`}
      onClick={onClick}
      type={type}
    >
      {children}
    </Element>
  );
};

const Header = () => {
  const [isScrolled, setIsScrolled] = useState(false);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);

  useEffect(() => {
    const handleScroll = () => {
      setIsScrolled(window.scrollY > 50);
    };
    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  return (
    <header className={`fixed top-0 w-full z-50 transition-all duration-500 ${isScrolled ? 'bg-[#101010]/95 backdrop-blur-md py-4 shadow-lg shadow-black/50' : 'bg-transparent py-6'}`}>
      <div className="max-w-7xl mx-auto px-6 md:px-12 flex justify-between items-center">
        {/* Logo */}
        <a href="#home" className="flex flex-col">
          <span className="font-heading text-2xl font-light tracking-[0.2em] text-[#F2EFE8]">
            {config.brand.name}
          </span>
          {isScrolled && (
            <span className="text-[0.55rem] tracking-widest text-[#C5A477] uppercase hidden md:block opacity-80 mt-1">
              {config.brand.signature}
            </span>
          )}
        </a>

        {/* Desktop Nav */}
        <nav className="hidden lg:flex items-center gap-8">
          {config.nav.map((item, idx) => (
            <a 
              key={idx} 
              href={item.href}
              className="text-sm text-[#F2EFE8]/80 hover:text-[#C5A477] transition-colors font-heading tracking-wide"
            >
              {item.label}
            </a>
          ))}
          <Button href="#contato" variant="primary" className="ml-4 py-2 px-5 text-xs">
            Vamos conversar
          </Button>
        </nav>

        {/* Mobile Menu Toggle */}
        <button 
          className="lg:hidden text-[#F2EFE8] hover:text-[#C5A477] transition-colors"
          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
        >
          {mobileMenuOpen ? <X size={28} /> : <Menu size={28} />}
        </button>
      </div>

      {/* Mobile Nav */}
      <div className={`lg:hidden absolute top-full left-0 w-full bg-[#101010]/95 backdrop-blur-md overflow-hidden transition-all duration-300 ${mobileMenuOpen ? 'max-h-screen border-b border-[#303234]' : 'max-h-0'}`}>
        <nav className="flex flex-col px-6 py-4 space-y-4">
          {config.nav.map((item, idx) => (
            <a 
              key={idx} 
              href={item.href}
              onClick={() => setMobileMenuOpen(false)}
              className="text-base text-[#F2EFE8]/80 hover:text-[#C5A477] py-2 border-b border-[#303234]/50"
            >
              {item.label}
            </a>
          ))}
          <div className="pt-4">
            <Button href="#contato" variant="primary" className="w-full justify-center" onClick={() => setMobileMenuOpen(false)}>
              Vamos conversar
            </Button>
          </div>
